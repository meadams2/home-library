<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #F5F7FA;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.bsu.cs.graphic.HomeLibraryGUI">
    <opaqueInsets>
        <Insets left="6.0" top="6.0" />
    </opaqueInsets>
    <padding>
        <Insets left="6.0" top="8.0" />
    </padding>
    <Label alignment="CENTER" text="My Stack: Home Library Software">
        <font>
          <Font name="Book Antiqua Bold" size="24.0" />
        </font>
      <VBox.margin>
         <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
      </VBox.margin>
    </Label>
   <Button fx:id="addBook" mnemonicParsing="false" text="Add Book">
      <font>
         <Font name="Gill Sans MT" size="12.0" />
      </font>
      <VBox.margin>
         <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
      </VBox.margin>
   </Button>
    <HBox>
        <TextField fx:id="searchTerm" prefHeight="15.0" prefWidth="505.0" promptText="Enter Search Term">
            <HBox.margin>
                <Insets bottom="4.0" left="4.0" right="4.0" top="6.0" />
            </HBox.margin>
        </TextField>
        <MenuButton fx:id="searchMethodMenuButton" alignment="TOP_LEFT" contentDisplay="TOP" mnemonicParsing="false" text="Search By:">
            <items>
                <MenuItem fx:id="searchTitleChoice" mnemonicParsing="false" onAction="#handleSearchByTitle" text="Title" />
                <MenuItem fx:id="searchAuthorChoice" mnemonicParsing="false" onAction="#handleSearchByAuthor" text="Author" />
            </items>
            <font>
                <Font name="Gill Sans MT" size="12.0" />
            </font>
            <opaqueInsets>
                <Insets left="6.0" top="6.0" />
            </opaqueInsets>
            <HBox.margin>
                <Insets bottom="4.0" left="4.0" right="6.0" top="8.0" />
            </HBox.margin>
        </MenuButton>
      <VBox.margin>
         <Insets />
      </VBox.margin>
    </HBox>
    <TableView fx:id="bookEntryTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="289.0" prefWidth="588.0">
      <columns>
          <TableColumn fx:id="bookDataColumn" prefWidth="294.0000100135803" text="Books" />
          <TableColumn fx:id="checkoutBookColumn" minWidth="-Infinity" text="Checkout" />
         <TableColumn fx:id="deleteBookColumn" prefWidth="75.0" text="Delete" />
      </columns>
        <columnResizePolicy>
          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
        <VBox.margin>
          <Insets left="4.0" right="4.0" top="4.0" />
        </VBox.margin>
    </TableView>
</VBox>
