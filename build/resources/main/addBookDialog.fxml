<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0"
      prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.bsu.cs.graphic.AddBookDialogController">
    <Label text="Add Book to Library">
        <font>
          <Font name="Gill Sans MT" size="18.0"/>
        </font>
        <VBox.margin>
          <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
        </VBox.margin>
    </Label>
    <Label text="Title">
        <VBox.margin>
          <Insets left="8.0" top="4.0"/>
        </VBox.margin>
    </Label>
    <TextField fx:id="titleField">
        <VBox.margin>
          <Insets bottom="4.0" left="8.0" right="8.0" top="4.0"/>
        </VBox.margin>
    </TextField>
    <Label text="Author">
        <VBox.margin>
          <Insets bottom="2.0" left="8.0" top="2.0"/>
        </VBox.margin>
    </Label>
    <TextField fx:id="authorField">
        <VBox.margin>
          <Insets left="8.0" right="8.0" top="2.0"/>
        </VBox.margin>
    </TextField>
    <Label text="ISBN">
        <VBox.margin>
          <Insets left="8.0" top="2.0"/>
        </VBox.margin>
    </Label>
    <TextField fx:id="isbnField">
        <VBox.margin>
          <Insets bottom="2.0" left="8.0" right="8.0" top="2.0"/>
        </VBox.margin>
    </TextField>
    <Label text="Location">
        <VBox.margin>
          <Insets bottom="2.0" left="8.0" right="8.0" top="2.0"/>
        </VBox.margin>
    </Label>
    <TextField fx:id="locationField">
        <VBox.margin>
          <Insets bottom="2.0" left="8.0" right="8.0" top="2.0"/>
        </VBox.margin>
    </TextField>
    <Button fx:id="addToLibraryButton" mnemonicParsing="false" onAction="#handleAddBook" text="Add to Library">
        <VBox.margin>
          <Insets left="8.0" top="4.0"/>
        </VBox.margin>
    </Button>
</VBox>
